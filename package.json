{
  "name": "fiuba-reviews",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @fiuba-reviews/sitio-web dev",
    "build": "pnpm --filter @fiuba-reviews/sitio-web build",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test"
  },
  "devDependencies": {
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0"
  },
  "packageManager": "pnpm@12.9.0"
}
