{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "none",
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./sitio-web/src/app/globals.css",
    "functions": ["cn", "clsx", "cva"]
  },
  "ignorePatterns": [
    "**/.next/**",
    "**/out/**",
    "**/build/**",
    "**/next-env.d.ts",
    "pnpm-lock.yaml"
  ],
  "sortImports": {
    "internalPattern": ["@/", "@fiuba-reviews/"],
    "newlinesBetween": false,
    "customGroups": [
      {
        "groupName": "react-next",
        "elementNamePattern": ["^(react|next)(/.*)?$"]
      }
    ],
    "groups": [
      "react-next",
      "type",
      ["builtin", "external"],
      "internal",
      ["parent", "sibling", "index"],
      "unknown"
    ]
  }
}
